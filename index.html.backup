<!-- ─── SERVICES ─── -->
<section id="services" class="section">
  <div class="container">
    <div class="services-header fade-in">
      <div class="section-tag">What We Build</div>
      <h2 class="section-title">If It's Repetitive,<br><span class="highlight">We Automate It.</span></h2>
      <p class="section-sub">Every solution is custom-coded for your exact workflow. No templates. No one-size-fits-all. Just automation that actually works.</p>
    </div>
    <div class="services-grid">
      <div class="service-card fade-in">
        <div class="service-icon">💬</div>
        <div class="service-title">WhatsApp Automation</div>
        <p class="service-desc">Your customers text, your business responds — instantly. We build intelligent WhatsApp bots using either pre-programmed logic or Claude AI for fully human-like conversations that close leads while you sleep.</p>
        <div class="service-tags">
          <span class="tag">Pre-programmed Flows</span>
          <span class="tag">Claude AI Conversations</span>
          <span class="tag">24/7 Response</span>
        </div>
        <a href="#cta-banner" class="service-link" style="margin-top:20px;display:inline-flex;">Start automating →</a>
      </div>

      <div class="service-card fade-in fade-in-delay-1">
        <div class="service-icon">🎯</div>
        <div class="service-title">Lead Follow-Up & Nurture</div>
        <p class="service-desc">Never lose a hot lead to slow response times again. Automated follow-up sequences that reach out at the perfect moment — personalised, timely, and consistent — without you lifting a finger.</p>
        <div class="service-tags">
          <span class="tag">Instant Response</span>
          <span class="tag">Multi-touch Sequences</span>
          <span class="tag">CRM Integration</span>
        </div>
        <a href="#cta-banner" class="service-link" style="margin-top:20px;display:inline-flex;">Start automating →</a>
      </div>

      <div class="service-card fade-in fade-in-delay-2">
        <div class="service-icon">⭐</div>
        <div class="service-title">Review & Client Retention</div>
        <p class="service-desc">Automatically request reviews at the right moment, re-engage inactive clients, and build loyalty workflows that keep your customers coming back. Turn happy customers into raving fans on autopilot.</p>
        <div class="service-tags">
          <span class="tag">Review Requests</span>
          <span class="tag">Retention Flows</span>
          <span class="tag">Win-back Campaigns</span>
        </div>
        <a href="#cta-banner" class="service-link" style="margin-top:20px;display:inline-flex;">Start automating →</a>
      </div>

      <div class="service-card fade-in fade-in-delay-3">
        <div class="service-icon">⚙️</div>
        <div class="service-title">Custom Process Automation</div>
        <p class="service-desc">Appointment booking, data entry, reporting, invoicing, onboarding — if a human is doing it on repeat, we can automate it. Fully integrated with your existing tools: Google Calendar, CRMs, spreadsheets and more.</p>
        <div class="service-tags">
          <span class="tag">Booking Systems</span>
          <span class="tag">Data Pipelines</span>
          <span class="tag">Tool Integrations</span>
        </div>
        <a href="#cta-banner" class="service-link" style="margin-top:20px;display:inline-flex;">Start automating →</a>
      </div>
    </div>
  </div>
</section>

<!-- ─── PROCESS ─── -->
<section id="process" class="section">
  <div class="container">
    <div class="process-header fade-in">
      <div class="section-tag">How We Work</div>
      <h2 class="section-title">Behind Every Great Result Is a<br><span class="highlight">Process That Just Works</span></h2>
      <p class="section-sub">We don't do templates. Every automation is built from scratch for your specific business. Here's how we go from idea to impact.</p>
    </div>
    <div class="process-steps">
      <div class="process-step fade-in">
        <div class="step-num">01</div>
        <div class="step-icon">🔍</div>
        <div class="step-title">Discovery</div>
        <p class="step-desc">We map your exact workflow, identify the highest-impact bottlenecks, and define what we'll automate first. No assumptions — just clarity.</p>
      </div>
      <div class="process-step fade-in fade-in-delay-1">
        <div class="step-num">02</div>
        <div class="step-icon">🛠️</div>
        <div class="step-title">Build</div>
        <p class="step-desc">Custom-coded solution built specifically for you. We choose between structured logic or AI-powered conversation depending on your needs.</p>
      </div>
      <div class="process-step fade-in fade-in-delay-2">
        <div class="step-num">03</div>
        <div class="step-icon">🚀</div>
        <div class="step-title">Deploy & Optimise</div>
        <p class="step-desc">We launch, monitor, and continuously improve your automation. You get monthly reports and we iterate based on real results.</p>
      </div>
    </div>
  </div>
</section>

<!-- ─── WHATSAPP SPOTLIGHT ─── -->
<section id="whatsapp" class="section">
  <div class="container">
    <div class="wa-inner">
