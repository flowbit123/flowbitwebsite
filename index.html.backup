<script>
  /* ─── Orbiting AI Core Canvas ─── */
  (function initWorkflow() {
    const canvas = document.getElementById('wf-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');

    const dpr = window.devicePixelRatio || 1;
    const W = 420, H = 300;
    canvas.width  = W * dpr;
    canvas.height = H * dpr;
    canvas.style.width  = '100%';
    canvas.style.height = H + 'px';
    ctx.scale(dpr, dpr);

    const G = '#AAFF00';
    /* Orb sits left-of-centre; stats fill the right column */
    const OCX = 168, OCY = 150, ORB = 46;

    /* Two elliptical orbital rings – rx/ry create the 3-D tilt */
    const RINGS = [
      { rx: 88,  ry: 30 },
      { rx: 145, ry: 48 },
    ];

    const orbitals = [
      { icon:'💬', label:'WhatsApp',  a: 0.0,  ring:0, spd:0.0095 },
      { icon:'📧', label:'Gmail',     a: 2.1,  ring:0, spd:0.0082 },
      { icon:'📅', label:'Calendar',  a: 4.3,  ring:0, spd:0.0100 },
      { icon:'💼', label:'Slack',     a: 0.5,  ring:1, spd:0.0052 },
      { icon:'🤝', label:'CRM',       a: 2.3,  ring:1, spd:0.0058 },
      { icon:'📊', label:'Sheets',    a: 3.9,  ring:1, spd:0.0046 },
      { icon:'📝', label:'Notion',    a: 5.5,  ring:1, spd:0.0054 },
    ];

    let tick = 0;

    /* ── helpers ── */
    function pos(o) {
      const r = RINGS[o.ring];
      const x = OCX + Math.cos(o.a) * r.rx;
      const y = OCY + Math.sin(o.a) * r.ry;
      const depth = Math.sin(o.a);           /* -1 = behind, +1 = front */
      return { x, y, depth };
    }

    /* ── dashed ellipse orbit tracks ── */
    function drawTracks() {
      RINGS.forEach(r => {
        ctx.save();
        ctx.setLineDash([3, 7]);
        ctx.beginPath();
        ctx.ellipse(OCX, OCY, r.rx, r.ry, 0, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(170,255,0,0.07)';
        ctx.lineWidth = 1;
        ctx.stroke();
        ctx.restore();
      });
    }

    /* ── thin line + travelling dot from orb edge to each icon ── */
    function drawConnection(o) {
      const p   = pos(o);
      const dx  = p.x - OCX, dy = p.y - OCY;
      const len = Math.sqrt(dx*dx + dy*dy) || 1;
      const ex  = OCX + (dx/len)*(ORB+3);
      const ey  = OCY + (dy/len)*(ORB+3);
      const a   = ((p.depth + 1) * 0.5) * 0.28 + 0.04;

      ctx.beginPath();
      ctx.moveTo(ex, ey);
      ctx.lineTo(p.x, p.y);
      ctx.strokeStyle = `rgba(170,255,0,${a})`;
      ctx.lineWidth = 0.9;
      ctx.stroke();

      /* travelling pulse dot */
      const t  = (Math.sin(tick * 0.045 + o.a * 2) * 0.5 + 0.5);
      const px = ex + (p.x - ex) * t;
      const py = ey + (p.y - ey) * t;
      ctx.save();
      ctx.shadowBlur = 10; ctx.shadowColor = G;
      ctx.beginPath(); ctx.arc(px, py, 2, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(170,255,0,${a * 3.5})`; ctx.fill();
      ctx.restore();
    }

    /* ── single orbiting icon bubble ── */
    function drawOrbital(o) {
      const p = pos(o);
      if (p.depth < -0.72) return;            /* hide when far behind */

      const scale  = 0.62 + (p.depth + 1) * 0.5 * 0.52;   /* 0.62–1.14 */
      const alpha  = 0.42 + (p.depth + 1) * 0.5 * 0.58;   /* 0.42–1.0  */
      const r      = 18 * scale;

      ctx.save();
      ctx.globalAlpha = alpha;

      /* outer halo for front icons */
      if (p.depth > 0.15) {
        const halo = ctx.createRadialGradient(p.x, p.y, r * 0.6, p.x, p.y, r * 2.2);
        halo.addColorStop(0, 'rgba(170,255,0,0.12)');
        halo.addColorStop(1, 'transparent');
        ctx.beginPath(); ctx.arc(p.x, p.y, r * 2.2, 0, Math.PI * 2);
        ctx.fillStyle = halo; ctx.fill();
      }

      /* icon circle */
      ctx.save();
      ctx.shadowBlur = p.depth > 0 ? 14 : 4;
      ctx.shadowColor = 'rgba(170,255,0,0.45)';
      ctx.beginPath(); ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(10,14,5,0.96)'; ctx.fill();
      ctx.strokeStyle = `rgba(170,255,0,${0.32 + p.depth * 0.38})`;
      ctx.lineWidth = 1.1; ctx.stroke();
      ctx.restore();

      /* emoji icon */
      ctx.font = `${Math.round(13 * scale)}px sans-serif`;
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText(o.icon, p.x, p.y + 1);

      /* label — only when clearly in front */
      if (p.depth > 0.25) {
        ctx.font = `bold ${Math.round(8 * scale)}px Inter,sans-serif`;
        ctx.fillStyle = `rgba(170,255,0,${alpha * 0.78})`;
        ctx.textBaseline = 'top';
        ctx.fillText(o.label, p.x, p.y + r + 3 * scale);
      }

      ctx.restore();
    }

    /* ── central glowing orb ── */
    function drawOrb() {
      const pulse = Math.sin(tick * 0.027) * 0.5 + 0.5;

      /* ambient glow layers */
      [100, 76, 56].forEach((gr, i) => {
        const a = [0.03, 0.06, 0.11][i];
        const g = ctx.createRadialGradient(OCX, OCY, 0, OCX, OCY, gr);
        g.addColorStop(0, `rgba(170,255,0,${a})`);
        g.addColorStop(1, 'transparent');
        ctx.beginPath(); ctx.arc(OCX, OCY, gr, 0, Math.PI * 2);
        ctx.fillStyle = g; ctx.fill();
      });

      /* orb body */
      const bg = ctx.createRadialGradient(OCX - 12, OCY - 12, 4, OCX, OCY, ORB);
      bg.addColorStop(0,   'rgba(62, 82, 26, 0.97)');
      bg.addColorStop(0.4, 'rgba(28, 38, 12, 0.98)');
      bg.addColorStop(1,   'rgba( 7, 10,  3, 0.99)');
      ctx.beginPath(); ctx.arc(OCX, OCY, ORB, 0, Math.PI * 2);
      ctx.fillStyle = bg; ctx.fill();

      /* orb border */
      ctx.save();
      ctx.shadowBlur = 20 + pulse * 14; ctx.shadowColor = G;
      ctx.beginPath(); ctx.arc(OCX, OCY, ORB, 0, Math.PI * 2);
      ctx.strokeStyle = `rgba(170,255,0,${0.5 + pulse * 0.35})`;
      ctx.lineWidth = 1.6; ctx.stroke();
      ctx.restore();

      /* spinning arcs */
      ctx.save(); ctx.translate(OCX, OCY);
      ctx.beginPath();
      ctx.arc(0, 0, ORB + 11, tick * 0.022, tick * 0.022 + Math.PI * 1.5);
      ctx.strokeStyle = `rgba(170,255,0,${0.18 + pulse * 0.12})`; ctx.lineWidth = 1; ctx.stroke();
      ctx.beginPath();
      ctx.arc(0, 0, ORB + 20, -tick * 0.017, -tick * 0.017 + Math.PI * 0.75);
      ctx.strokeStyle = `rgba(170,255,0,${0.1 + pulse * 0.07})`; ctx.lineWidth = 0.7; ctx.stroke();
      /* third tight ring */
      ctx.beginPath();
      ctx.arc(0, 0, ORB + 5,  tick * 0.035, tick * 0.035 + Math.PI * 0.5);
      ctx.strokeStyle = `rgba(170,255,0,${0.25 + pulse * 0.15})`; ctx.lineWidth = 1.2; ctx.stroke();
      ctx.restore();

      /* label */
      ctx.save();
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.shadowBlur = 10; ctx.shadowColor = G;
      ctx.font = 'bold 12px Inter,sans-serif'; ctx.fillStyle = G;
      ctx.fillText('AI CORE', OCX, OCY - 9);
      ctx.shadowBlur = 0;
      ctx.font = '9px Inter,sans-serif'; ctx.fillStyle = 'rgba(255,255,255,0.42)';
      ctx.fillText('Claude API', OCX, OCY + 6);
      /* processing dots */
      [-8, 0, 8].forEach((dx, di) => {
        const dp = Math.sin(tick * 0.09 + di * 1.25) * 0.5 + 0.5;
        ctx.beginPath(); ctx.arc(OCX + dx, OCY + 20, 2.2, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(170,255,0,${0.25 + dp * 0.75})`; ctx.fill();
      });
      ctx.restore();
    }

    /* ── right-side stat readout ── */
    function drawStats() {
      const stats = [
        { val: '100%', sub: 'Response rate' },
        { val: '24/7',  sub: 'Always active'  },
        { val: '< 1s',  sub: 'Reply time'     },
      ];
      const sx = W - 94, sy = 72;
      ctx.textAlign = 'left';
      stats.forEach((s, i) => {
        const pulse = Math.sin(tick * 0.022 + i * 0.9) * 0.5 + 0.5;
        const y = sy + i * 68;

        ctx.save();
        ctx.shadowBlur = 6; ctx.shadowColor = 'rgba(255,255,255,0.15)';
        ctx.font = 'bold 22px Inter,sans-serif';
        ctx.fillStyle = `rgba(255,255,255,${0.82 + pulse * 0.18})`;
        ctx.fillText(s.val, sx, y);
        ctx.restore();

        ctx.font = '10px Inter,sans-serif';
        ctx.fillStyle = 'rgba(107,114,128,0.88)';
        ctx.fillText(s.sub, sx, y + 16);

        /* neon accent underline */
        ctx.beginPath(); ctx.moveTo(sx, y + 24); ctx.lineTo(sx + 36, y + 24);
        ctx.strokeStyle = `rgba(170,255,0,${0.18 + pulse * 0.22})`;
        ctx.lineWidth = 0.9; ctx.stroke();
      });
    }

    /* ── main render loop ── */
    function draw() {
      ctx.clearRect(0, 0, W, H);

      drawTracks();

      /* depth-sort for correct overlap: back icons first, orb, front icons */
      const sorted = orbitals.slice().sort((a, b) => pos(a).depth - pos(b).depth);
      const behind = sorted.filter(o => pos(o).depth <  0);
      const front  = sorted.filter(o => pos(o).depth >= 0);

      /* draw all connector lines first (under icons) */
      orbitals.forEach(drawConnection);

      behind.forEach(drawOrbital);
      drawOrb();
      front.forEach(drawOrbital);

      drawStats();

      /* advance orbital angles */
      orbitals.forEach(o => { o.a += o.spd; });
      tick++;
      requestAnimationFrame(draw);
    }

    draw();
  })();

  /* ─── Hamburger menu ─── */
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobileMenu');
  hamburger.addEventListener('click', () => mobileMenu.classList.toggle('open'));
  document.querySelectorAll('.mobile-link, .mobile-menu .btn').forEach(link => {
    link.addEventListener('click', () => mobileMenu.classList.remove('open'));
  });

  /* ─── Scroll fade-in ─── */
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

  /* ─── Typewriter ─── */
  const phrases = ['Scale Without Limits.', 'WhatsApp Automation.', 'Close Leads 24/7.', 'Retain More Clients.', 'Eliminate Manual Work.'];
  let pi = 0, ci = 0, deleting = false;
  const tw = document.getElementById('typewriter');
  function typeLoop() {
    const phrase = phrases[pi];
    const cur = tw.childNodes[0];
    if (!deleting) {
      tw.childNodes[0] ? tw.childNodes[0].textContent = phrase.slice(0, ci++) : tw.prepend(document.createTextNode(phrase.slice(0, ci++)));
      if (ci > phrase.length) { deleting = true; setTimeout(typeLoop, 1800); return; }
    } else {
      if (tw.childNodes[0]) tw.childNodes[0].textContent = phrase.slice(0, --ci);
      if (ci === 0) { deleting = false; pi = (pi + 1) % phrases.length; setTimeout(typeLoop, 300); return; }
    }
    setTimeout(typeLoop, deleting ? 40 : 70);
  }
  // Re-init typewriter properly
  tw.innerHTML = '<span class="cursor"></span>';
  let twText = '';
  let twPhrase = phrases[0];
  let twIdx = 0;
  let twDeleting = false;
  let twPhraseIdx = 0;
  function typeWriter() {
    const full = phrases[twPhraseIdx];
    if (!twDeleting) {
      twText = full.slice(0, ++twIdx);
    } else {
      twText = full.slice(0, --twIdx);
    }
    const cursor = tw.querySelector('.cursor');
    tw.textContent = twText;
    tw.appendChild(cursor);
    if (!twDeleting && twText === full) {
      setTimeout(() => { twDeleting = true; setTimeout(typeWriter, 50); }, 2000);
    } else if (twDeleting && twText === '') {
      twDeleting = false;
      twPhraseIdx = (twPhraseIdx + 1) % phrases.length;
      twIdx = 0;
      setTimeout(typeWriter, 400);
    } else {
      setTimeout(typeWriter, twDeleting ? 45 : 80);
    }
  }
  setTimeout(typeWriter, 800);

  /* ─── Count-up stats ─── */
  function animateCount(el, target, suffix) {
    let start = 0;
    const step = Math.ceil(target / 60);
    const timer = setInterval(() => {
      start += step;
      if (start >= target) { el.textContent = target + suffix; clearInterval(timer); return; }
      el.textContent = start + suffix;
    }, 30);
  }
  const statsObserver = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        animateCount(document.getElementById('count1'), 200, '+');
        animateCount(document.getElementById('count2'), 50, '+');
        statsObserver.disconnect();
      }
    });
  }, { threshold: 0.5 });
  const statsEl = document.querySelector('.hero-stats');
  if (statsEl) statsObserver.observe(statsEl);

  /* ─── Particle canvas ─── */
  const canvas = document.getElementById('particle-canvas');
  const ctx = canvas.getContext('2d');
  let W, H, particles = [];
  function resize() {
    W = canvas.width = canvas.offsetWidth;
    H = canvas.height = canvas.offsetHeight;
  }
  class Particle {
    constructor() { this.reset(); }
    reset() {
      this.x = Math.random() * W;
      this.y = Math.random() * H;
      this.r = Math.random() * 1.5 + 0.3;
      this.vx = (Math.random() - 0.5) * 0.3;
      this.vy = (Math.random() - 0.5) * 0.3;
      this.alpha = Math.random() * 0.4 + 0.1;
    }
    update() {
      this.x += this.vx; this.y += this.vy;
      if (this.x < 0 || this.x > W || this.y < 0 || this.y > H) this.reset();
    }
    draw() {
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(170,255,0,${this.alpha})`;
      ctx.fill();
    }
  }
  function initParticles() {
    particles = [];
    const count = Math.floor((W * H) / 12000);
    for (let i = 0; i < count; i++) particles.push(new Particle());
  }
  function drawConnections() {
    for (let i = 0; i < particles.length; i++) {
      for (let j = i + 1; j < particles.length; j++) {
        const dx = particles[i].x - particles[j].x;
        const dy = particles[i].y - particles[j].y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < 100) {
          ctx.beginPath();
          ctx.moveTo(particles[i].x, particles[i].y);
          ctx.lineTo(particles[j].x, particles[j].y);
          ctx.strokeStyle = `rgba(170,255,0,${0.08 * (1 - dist / 100)})`;
          ctx.lineWidth = 0.5;
          ctx.stroke();
        }
      }
    }
  }
  function animateParticles() {
    ctx.clearRect(0, 0, W, H);
    particles.forEach(p => { p.update(); p.draw(); });
    drawConnections();
    requestAnimationFrame(animateParticles);
  }
  window.addEventListener('resize', () => { resize(); initParticles(); });
  resize(); initParticles(); animateParticles();

  /* ─── WhatsApp tabs ─── */
  document.querySelectorAll('.wa-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.wa-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const which = tab.dataset.tab;
      document.getElementById('tab-programmed').style.display = which === 'programmed' ? 'flex' : 'none';
      document.getElementById('tab-ai').style.display = which === 'ai' ? 'flex' : 'none';
    });
  });

  /* ─── FAQ accordion ─── */
  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question').addEventListener('click', () => {
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => {
        i.classList.remove('open');
        i.querySelector('.faq-answer').style.maxHeight = null;
      });
      if (!isOpen) {
        item.classList.add('open');
        const ans = item.querySelector('.faq-answer');
        ans.style.maxHeight = ans.scrollHeight + 'px';
      }
    });
  });

  /* ─── Navbar background on scroll ─── */
  window.addEventListener('scroll', () => {
    const nav = document.getElementById('navbar');
    nav.style.background = window.scrollY > 20 ? 'rgba(10,10,10,0.95)' : 'rgba(10,10,10,0.7)';
  });
</script>
</body>
</html>
